{
  "name": "playtest",
  "version": "0.0.0",
  "private": true,
  "description": "PlayTest \u2014 Electron + Playwright manual-tester studio",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "postinstall": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "PLAYTEST_E2E=1 npx vitest run tests/e2e-local-site.test.ts tests/e2e-dummy-tax-site.test.ts tests/e2e-git-sync.test.ts tests/e2e-transfer.test.ts tests/e2e-assertions.test.ts",
    "dummy:tax-site": "node dummy-tax-site/server.js --port 4137",
    "seed:dummy-tax": "node scripts/seed-dummy-tax.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format && npm test"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "^44.8.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "electron-squirrel-startup": "^1.0.1",
    "isomorphic-git": "^1.44.2",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
